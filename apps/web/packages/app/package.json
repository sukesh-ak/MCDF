{
  "name": "@mcdf/app",
  "version": "0.1.0",
  "private": true,
  "description": "MCDF Web — the accessible browser client",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build --workspace ../mcdf-ts --if-present && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.6",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "codemirror": "^6.0.1",
    "mcdf-ts": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.2.6",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
