#
# CMake package config for libmcdf: `find_package(mcdf CONFIG REQUIRED)`
# provides the mcdf::mcdf target. libmcdf is a static library, so its link
# dependencies must be findable in the consumer's environment too (vcpkg
# supplies them automatically when consuming through the port).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json CONFIG)
find_dependency(OpenSSL)
find_dependency(yaml-cpp CONFIG)
find_dependency(md4c CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(pugixml CONFIG)
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/mcdfTargets.cmake")

check_required_components(mcdf)
