# Keep the build context small and private material out of the image.
.git
.gitignore
.gitattributes

# Private research & plans (also gitignored) — never copy into an image.
internal/

# Build output & vcpkg artifacts
build/
**/build/
vcpkg_installed/
**/vcpkg_installed/

# Web client: dependencies are installed inside the image (and contain workspace
# symlinks that do not survive being copied), so the host tree must stay out of
# the build context. Build output is regenerated too.
**/node_modules/
apps/web/packages/*/dist/
**/playwright-report/
**/test-results/

# Editor / OS noise
.vscode/
.idea/
*.user
.DS_Store
Thumbs.db

# Docs not needed to build
docs/
